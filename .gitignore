# Compiled binaries
bin/console-ir-linux
bin/console-ir-macos
bin/console-ir-macos-arm64
bin/console-ir.exe
bin/*-nocgo*
bin/*
dist/
coverage.out
coverage.html

# Built plugin executables
plugins/intelowl/intelowl
plugins/misp/misp
plugins/opencti/opencti

# Database files (SQLite) — safety net; runtime DBs live under data/ (below)
*.db
*.db-*

# Log files
*.log
console-ir-ui.log
debug_output.log
ui-debug.log

# Release preparation directories
release-*/

# Temporary files
*.tmp
*.temp
bin/*

# Runtime data — created by the binary at run time; never committed
data/
logs/
exports/
config/llm_settings.json

# Local-only workspace for agent notes, reports, and scratch files
.local/
.codex

# Folder-ingest resume state
.ingest-offsets.state
.ingest-offsets.state.tmp
